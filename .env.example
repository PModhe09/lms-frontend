# Copy to .env.local for local runs.

# Where Next.js forwards /api/* (server-side only, never exposed to the browser).
API_ORIGIN=http://localhost:4000

# Same value as the backend's JWT_SECRET. proxy.ts verifies the session signature for UX redirects only;
# the API re-checks every request.
JWT_SECRET=change-me-to-a-long-random-string-of-48-chars
